  <DataSets>
    <DataSet Name="dsetSpecialties">
      <Query>
        <DataSourceName>dsProviderData</DataSourceName>
        <CommandText>SELECT '(All)' AS taxonomy_description 
UNION 
SELECT DISTINCT taxonomy_description 
FROM dbo.provider_export 
WHERE taxonomy_description IS NOT NULL 
ORDER BY taxonomy_description;</CommandText>
      </Query>
      <Fields>
        <Field Name="taxonomy_description">
          <DataField>taxonomy_description</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsetCities">
      <Query>
        <DataSourceName>dsProviderData</DataSourceName>
        <CommandText>SELECT '(All)' AS city 
UNION 
SELECT DISTINCT city 
FROM dbo.provider_export 
WHERE city IS NOT NULL 
ORDER BY city;</CommandText>
      </Query>
      <Fields>
        <Field Name="city">
          <DataField>city</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsetSummary">
      <Query>
        <DataSourceName>dsProviderData</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Specialty">
            <Value>=Parameters!Specialty.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@City">
            <Value>=Parameters!City.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@StaleYears">
            <Value>=Parameters!StaleYears.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>usp_GetProviderQualitySummary</CommandText>
      </Query>
      <Fields>
        <Field Name="rule_name">
          <DataField>rule_name</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="severity">
          <DataField>severity</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="flagged_count">
          <DataField>flagged_count</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="total_records_evaluated">
          <DataField>total_records_evaluated</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="rule_status">
          <DataField>rule_status</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsetAgeBuckets">
      <Query>
        <DataSourceName>dsProviderData</DataSourceName>
        <QueryParameters>
          <QueryParameter Name="@Specialty">
            <Value>=Parameters!Specialty.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@City">
            <Value>=Parameters!City.Value</Value>
          </QueryParameter>
        </QueryParameters>
        <CommandText>SELECT 
    CASE 
        WHEN last_updated_date &gt;= DATEADD(year, -1, GETDATE()) THEN '&lt; 1 Year'
        WHEN last_updated_date &gt;= DATEADD(year, -3, GETDATE()) THEN '1 - 3 Years'
        WHEN last_updated_date &gt;= DATEADD(year, -5, GETDATE()) THEN '3 - 5 Years'
        WHEN last_updated_date &gt;= DATEADD(year, -7, GETDATE()) THEN '5 - 7 Years'
        ELSE '7+ Years'
    END AS age_bucket,
    COUNT(*) AS record_count,
    CASE 
        WHEN last_updated_date &gt;= DATEADD(year, -1, GETDATE()) THEN 1
        WHEN last_updated_date &gt;= DATEADD(year, -3, GETDATE()) THEN 2
        WHEN last_updated_date &gt;= DATEADD(year, -5, GETDATE()) THEN 3
        WHEN last_updated_date &gt;= DATEADD(year, -7, GETDATE()) THEN 4
        ELSE 5
    END AS sort_order
FROM dbo.provider_export
WHERE (@Specialty IS NULL OR @Specialty = '(All)' OR taxonomy_description = @Specialty)
  AND (@City IS NULL OR @City = '(All)' OR city = @City)
GROUP BY 
    CASE 
        WHEN last_updated_date &gt;= DATEADD(year, -1, GETDATE()) THEN '&lt; 1 Year'
        WHEN last_updated_date &gt;= DATEADD(year, -3, GETDATE()) THEN '1 - 3 Years'
        WHEN last_updated_date &gt;= DATEADD(year, -5, GETDATE()) THEN '3 - 5 Years'
        WHEN last_updated_date &gt;= DATEADD(year, -7, GETDATE()) THEN '5 - 7 Years'
        ELSE '7+ Years'
    END,
    CASE 
        WHEN last_updated_date &gt;= DATEADD(year, -1, GETDATE()) THEN 1
        WHEN last_updated_date &gt;= DATEADD(year, -3, GETDATE()) THEN 2
        WHEN last_updated_date &gt;= DATEADD(year, -5, GETDATE()) THEN 3
        WHEN last_updated_date &gt;= DATEADD(year, -7, GETDATE()) THEN 4
        ELSE 5
    END
ORDER BY sort_order;</CommandText>
      </Query>
      <Fields>
        <Field Name="age_bucket">
          <DataField>age_bucket</DataField>
          <rd:TypeName>System.String</rd:TypeName>
        </Field>
        <Field Name="record_count">
          <DataField>record_count</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
        <Field Name="sort_order">
          <DataField>sort_order</DataField>
          <rd:TypeName>System.Int32</rd:TypeName>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
